rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacherForClass(classId) {
      return isSignedIn() && exists(/databases/$(database)/documents/classes/$(classId)) &&
        (get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid ||
         (get(/databases/$(database)/documents/classes/$(classId)).data.teacherIds != null &&
          request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.teacherIds));
    }
    function isEnrolledInClass(classId) {
      return isSignedIn() && exists(/databases/$(database)/documents/classes/$(classId)) &&
        request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.studentIds;
    }

    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // Profile creation is performed by the trusted Firebase Admin server function.
      allow create: if false;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == uid && incoming().role == existing().role)
      );
      allow delete: if isAdmin() && uid != request.auth.uid;

      match /achievements/{userAchievementId} {
        allow read, write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      }
    }

    match /classes/{classId} {
      allow get: if isSignedIn() && (isAdmin() || resource.data.teacherId == request.auth.uid || request.auth.uid in resource.data.studentIds);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (incoming().teacherId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        isAdmin() || isTeacherForClass(classId) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['studentIds']) && request.auth.uid in incoming().studentIds)
      );
      allow delete: if isSignedIn() && (isAdmin() || resource.data.teacherId == request.auth.uid);
    }

    match /assignments/{assignmentId} {
      allow get: if isSignedIn() && (isAdmin() || isTeacherForClass(resource.data.classId) || isEnrolledInClass(resource.data.classId));
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (isTeacherForClass(incoming().classId) || isAdmin());
      allow update, delete: if isSignedIn() && (isAdmin() || isTeacherForClass(resource.data.classId));
      match /attachments/{attachmentId} {
        allow read: if isSignedIn() && (isAdmin() || isTeacherForClass(get(/databases/$(database)/documents/assignments/$(assignmentId)).data.classId) || isEnrolledInClass(get(/databases/$(database)/documents/assignments/$(assignmentId)).data.classId));
        allow create, update, delete: if isSignedIn() && (isAdmin() || isTeacherForClass(get(/databases/$(database)/documents/assignments/$(assignmentId)).data.classId));
      }
    }

    match /quizzes/{quizId} {
      allow get, list: if isSignedIn() && (isAdmin() || isTeacherForClass(resource.data.classId) || isEnrolledInClass(resource.data.classId));
      allow create: if isSignedIn() && (isTeacherForClass(incoming().classId) || isAdmin());
      allow update, delete: if isSignedIn() && (isAdmin() || isTeacherForClass(resource.data.classId));
      match /keys/{keyId} {
        allow read, write: if isSignedIn() && (isAdmin() || isTeacherForClass(get(/databases/$(database)/documents/quizzes/$(quizId)).data.classId));
      }
    }

    match /submissions/{submissionId} {
      allow get, list: if isSignedIn() && (isAdmin() || resource.data.studentId == request.auth.uid || isTeacherForClass(resource.data.classId));
      allow create: if isSignedIn() &&
        incoming().studentId == request.auth.uid &&
        incoming().status == 'submitted' &&
        incoming().score == null &&
        incoming().gradedBy == null &&
        incoming().gradedAt == null &&
        exists(/databases/$(database)/documents/classes/$(incoming().classId)) &&
        request.auth.uid in get(/databases/$(database)/documents/classes/$(incoming().classId)).data.studentIds &&
        (
          (incoming().type == 'assignment' &&
            exists(/databases/$(database)/documents/assignments/$(incoming().refId)) &&
            get(/databases/$(database)/documents/assignments/$(incoming().refId)).data.classId == incoming().classId) ||
          (incoming().type == 'quiz' &&
            exists(/databases/$(database)/documents/quizzes/$(incoming().refId)) &&
            get(/databases/$(database)/documents/quizzes/$(incoming().refId)).data.classId == incoming().classId)
        );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          isTeacherForClass(resource.data.classId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status','score','feedback','gradedBy','gradedAt']) &&
          incoming().status == 'graded' &&
          incoming().gradedBy == request.auth.uid &&
          incoming().gradedAt != null &&
          incoming().score >= 0 &&
          (
            (resource.data.type == 'assignment' &&
              incoming().score <= get(/databases/$(database)/documents/assignments/$(resource.data.refId)).data.maxPoints) ||
            (resource.data.type == 'quiz' &&
              incoming().score <= 10000)
          )
        )
      );
      allow delete: if isAdmin();
    }

    match /rubrics/{rubricId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.owner_id == request.auth.uid);
      allow create: if isSignedIn() && (isAdmin() || incoming().owner_id == request.auth.uid);
      allow update, delete: if isSignedIn() && (isAdmin() || resource.data.owner_id == request.auth.uid);
    }

    match /classes/{classId}/resources/{resourceId} {
      allow read: if isSignedIn() && (isAdmin() || isTeacherForClass(classId) || isEnrolledInClass(classId));
      allow create, update, delete: if isSignedIn() && (isAdmin() || isTeacherForClass(classId));
    }
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isAdmin() || incoming().author_id == request.auth.uid);
      allow update, delete: if isSignedIn() && (isAdmin() || resource.data.author_id == request.auth.uid);
    }
    match /classes/{classId}/discussions/{discussionId} {
      allow read: if isSignedIn() && (isAdmin() || isTeacherForClass(classId) || isEnrolledInClass(classId));
      allow create: if isSignedIn() && (isAdmin() || isTeacherForClass(classId) || isEnrolledInClass(classId));
      allow update, delete: if isSignedIn() && (isAdmin() || resource.data.author_id == request.auth.uid || isTeacherForClass(classId));
    }
    match /classes/{classId}/attendance/{dateId} {
      allow read: if isSignedIn() && (isAdmin() || isTeacherForClass(classId) || isEnrolledInClass(classId));
      allow write: if isSignedIn() && (isAdmin() || isTeacherForClass(classId));
    }
    match /achievements/{achievementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /leaderboard/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
  }
}