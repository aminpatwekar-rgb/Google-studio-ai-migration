rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'aminpatwekar@gmail.com';
    }

    // Whitelisted MIME types matching uploadConfig.ts
    function isAllowedContentType() {
      return request.resource.contentType in [
        'image/jpeg',
        'image/png',
        'image/webp',
        'application/pdf',
        'application/msword',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/vnd.ms-powerpoint',
        'application/vnd.openxmlformats-officedocument.presentationml.presentation',
        'text/plain',
        'video/mp4'
      ];
    }

    // Enforces max size constraints: Images (25 MB), Videos (500 MB), Documents (100 MB)
    function isWithinSizeLimit() {
      return (
        (request.resource.contentType.matches('image/.*') && request.resource.size <= 25 * 1024 * 1024) ||
        (request.resource.contentType == 'video/mp4' && request.resource.size <= 500 * 1024 * 1024) ||
        (!request.resource.contentType.matches('image/.*') && request.resource.contentType != 'video/mp4' && request.resource.size <= 100 * 1024 * 1024)
      );
    }

    function isValidUpload(uid) {
      return isSignedIn() &&
        request.auth.uid == uid &&
        isAllowedContentType() &&
        isWithinSizeLimit();
    }

    // Teacher assignment reference attachments
    match /assignments/{assignmentId}/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isValidUpload(uid);
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Student assignment submissions (both nested by assignment or flat by uid)
    match /submissions/{assignmentId}/{uid}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isValidUpload(uid);
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /submissions/{uid}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isValidUpload(uid);
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Teacher class resources & downloads
    match /class-resources/{classId}/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isValidUpload(uid);
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Announcement attachments
    match /announcements/{announcementId}/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isValidUpload(uid);
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Profile photos & user avatars (publicly readable once authenticated/shared)
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if isValidUpload(uid) && request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Quiz diagrams & question attachments
    match /quizzes/{quizId}/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isValidUpload(uid);
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Rubric attachments
    match /rubrics/{rubricId}/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isValidUpload(uid);
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Student project attachments
    match /projects/{projectId}/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isValidUpload(uid);
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Default deny for unmapped paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
